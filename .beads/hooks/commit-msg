#!/usr/bin/env sh
# --- mdeer: strip co-authorship trailers, enforce conventional commits ---
sed -i '/^[Cc]o-[Aa]uthored-[Bb]y:/d' "$1"
first=$(grep -v '^#' "$1" | head -n 1)
echo "$first" | grep -Eq '^(Merge |Revert |fixup! |squash! )' && exit 0
echo "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+' || {
  echo >&2 "commit-msg: not a conventional commit: '$first'"
  echo >&2 "  expected: <type>(<scope>)?: <subject>  e.g. 'feat(editor): add Ctrl+E toggle'"
  exit 1
}
